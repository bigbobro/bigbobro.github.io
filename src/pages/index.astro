---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import Datetime from "@/components/Datetime.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { getPostPresentation } from "@/utils/getPostPresentation";
import { getPath } from "@/utils/getPath";
import { slugifyStr } from "@/utils/slugify";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";

const sortedPosts = getSortedPosts(await getCollection("blog"));
const latestPost = [...sortedPosts].sort(
  (a, b) => b.data.pubDatetime.getTime() - a.data.pubDatetime.getTime()
)[0];
const latest = latestPost && getPostPresentation(latestPost.data);
const isWeekly = (entry: (typeof sortedPosts)[number]) =>
  entry.data.tags.includes("weekly-ai-signal");
const featuredPosts = sortedPosts.filter(
  entry => entry.data.featured && entry.id !== latestPost?.id
);
const practicePosts = sortedPosts.filter(
  entry =>
    !entry.data.featured && !isWeekly(entry) && entry.id !== latestPost?.id
);
const weeklyPosts = sortedPosts
  .filter(entry => isWeekly(entry) && entry.id !== latestPost?.id)
  .slice(0, 2);
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="home site-shell">
    <section class="masthead" aria-labelledby="masthead-title">
      <h1 id="masthead-title">Delulu <span>2</span> Solulu</h1>
      <p>想明白的写，没想明白的也写。</p>
    </section>

    {
      latestPost && latest && (
        <section class="latest" aria-labelledby="latest-title">
          <div class="latest-meta">
            <p class="latest-label">
              {latest.isWeekly
                ? "最新一期 / AI 周观察"
                : "最近更新 / 实践与复盘"}
            </p>
            <div class="latest-date">
              {latest.week && <span>{latest.week}</span>}
              <Datetime {...latestPost.data} />
            </div>
          </div>
          <div class="latest-story">
            <h2
              id="latest-title"
              style={{
                viewTransitionName: slugifyStr(
                  latestPost.data.title.replaceAll(".", "-")
                ),
              }}
            >
              <a href={getPath(latestPost.id, latestPost.filePath)}>
                {latest.title.split(/(?<=，)/u).map(phrase => (
                  <span class="headline-phrase">{phrase}</span>
                ))}
              </a>
            </h2>
            <div class="latest-deck">
              <p>{latestPost.data.description}</p>
              <a
                class="text-link"
                href={getPath(latestPost.id, latestPost.filePath)}
              >
                {latest.isWeekly ? "阅读本期" : "阅读文章"}
                <IconArrowRight aria-hidden="true" />
              </a>
            </div>
          </div>
        </section>
      )
    }

    <div class="editorial-columns">
      {
        featuredPosts.length > 0 && (
          <section id="featured" aria-labelledby="featured-title">
            <h2 id="featured-title" class="section-heading">
              精选文章
            </h2>
            <ul>
              {featuredPosts.map(post => (
                <Card variant="h3" presentation="featured" {...post} />
              ))}
            </ul>
          </section>
        )
      }
      {
        practicePosts.length > 0 && (
          <section id="practice-notes" aria-labelledby="practice-title">
            <h2 id="practice-title" class="section-heading">
              实践与复盘
            </h2>
            <ul>
              {practicePosts.slice(0, 3).map(post => (
                <Card variant="h3" {...post} />
              ))}
            </ul>
            {practicePosts.length > 3 && (
              <a class="text-link" href="/posts/">
                更多文章 <IconArrowRight aria-hidden="true" />
              </a>
            )}
          </section>
        )
      }
    </div>

    {
      weeklyPosts.length > 0 && (
        <section
          id="weekly-signal"
          class="weekly-index"
          aria-labelledby="weekly-title"
        >
          <h2 id="weekly-title">往期周观察</h2>
          <ul>
            {weeklyPosts.map(post => (
              <Card variant="h3" presentation="compact" {...post} />
            ))}
          </ul>
          <a class="text-link" href="/tags/weekly-ai-signal/">
            全部周观察 <IconArrowRight aria-hidden="true" />
          </a>
        </section>
      )
    }

    <div class="all-posts">
      <a class="text-link" href="/posts/">
        浏览全部文章 <IconArrowRight aria-hidden="true" />
      </a>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .masthead {
    padding-block: 2.75rem 2.5rem;
    text-align: center;
  }
  .masthead h1 {
    font-size: clamp(2.5rem, 6vw, 4.75rem);
    font-weight: 750;
    line-height: 1.15;
    letter-spacing: -0.04em;
  }
  .masthead h1 span {
    color: var(--accent);
    margin-inline: 0.08em;
  }
  .masthead p {
    margin-top: 1rem;
    color: color-mix(in srgb, var(--foreground) 70%, var(--background));
    font-size: 1rem;
    line-height: 1.8;
  }
  .latest {
    border-block: 1px solid var(--border);
  }
  .latest-meta,
  .latest-date {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
  }
  .latest-meta {
    justify-content: space-between;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--border);
    font-size: 0.8125rem;
  }
  .latest-label {
    color: var(--accent);
    font-weight: 550;
  }
  .latest-date {
    color: color-mix(in srgb, var(--foreground) 66%, var(--background));
    font-variant-numeric: tabular-nums;
  }
  .latest-story,
  .editorial-columns {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 4rem;
  }
  .latest-story {
    align-items: start;
    padding-block: 2rem;
  }
  .latest-story h2 {
    max-width: 20em;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 700;
    line-height: 1.5;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .latest-story h2 a:hover {
    color: var(--accent);
  }
  .headline-phrase {
    display: inline-block;
    max-width: 100%;
    text-wrap: pretty;
  }
  .latest-deck p {
    color: color-mix(in srgb, var(--foreground) 76%, var(--background));
    font-size: 1rem;
    line-height: 1.9;
    text-wrap: pretty;
  }
  .latest-deck .text-link {
    margin-top: 0.8rem;
  }
  .editorial-columns {
    padding-block: 2.5rem;
  }
  .editorial-columns > section {
    min-width: 0;
  }
  .editorial-columns > section:only-child {
    grid-column: 1 / -1;
  }
  .editorial-columns ul {
    display: grid;
    gap: 2rem;
  }
  .editorial-columns :global(.post-card) {
    padding: 0;
    border: 0;
  }
  .weekly-index {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr) auto;
    align-items: start;
    gap: 2rem;
    border-top: 1px solid var(--border);
    padding-top: 1.75rem;
  }
  .weekly-index h2 {
    padding-top: 0.15rem;
    font-size: 1.0625rem;
    font-weight: 650;
  }
  .weekly-index ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem;
  }
  .weekly-index :global(.post-card) {
    padding: 0;
    border: 0;
  }
  .weekly-index .text-link {
    white-space: nowrap;
  }
  .all-posts {
    display: flex;
    justify-content: flex-end;
    padding-block: 1.5rem 2rem;
  }
  @media (max-width: 899px) {
    .latest-story,
    .editorial-columns {
      gap: 2rem;
    }
    .weekly-index {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
  @media (max-width: 639px) {
    .masthead {
      padding-block: 1.75rem 1.5rem;
      text-align: left;
    }
    .masthead h1 {
      font-size: clamp(2rem, 9.3vw, 3rem);
    }
    .masthead p {
      margin-top: 0.65rem;
      font-size: 0.875rem;
    }
    .latest-meta {
      gap: 0.4rem;
      padding-block: 0.75rem;
    }
    .latest-date {
      gap: 0.65rem;
      font-size: 0.75rem;
    }
    .latest-story {
      grid-template-columns: 1fr;
      gap: 0.9rem;
      padding-block: 1.25rem;
    }
    .latest-story h2 {
      font-size: 1.5rem;
      line-height: 1.55;
    }
    .latest-deck p {
      font-size: 0.875rem;
      line-height: 1.85;
    }
    .latest-deck .text-link {
      margin-top: 0.6rem;
    }
    .editorial-columns {
      grid-template-columns: 1fr;
      gap: 1.75rem;
      padding-block: 1.75rem;
    }
    .editorial-columns > section + section {
      border-top: 1px solid var(--border);
      padding: 1.75rem 0 0;
    }
    .editorial-columns ul {
      gap: 1.75rem;
    }
    .section-heading {
      margin-bottom: 1.15rem;
      font-size: 1.1875rem;
    }
    .weekly-index ul {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .all-posts {
      justify-content: flex-start;
      padding-block: 1rem 1.5rem;
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    if (
      document.querySelector("#main-content")?.getAttribute("data-layout") ===
      "index"
    ) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
