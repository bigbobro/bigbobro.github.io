---
import type { CollectionEntry } from "astro:content";
import { slugifyStr } from "@/utils/slugify";
import { getPath } from "@/utils/getPath";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"blog">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;

const { title, description, tags = [], ...props } = data;
const isWeeklySignal = tags.includes("weekly-ai-signal");
---

<li class="border-b border-border/60 py-6 last:border-b-0">
  <div class="mb-2 flex flex-wrap items-center gap-2">
    <Datetime class="text-foreground/55" {...props} />
    {
      isWeeklySignal && (
        <span class="rounded border border-border px-1.5 py-0.5 text-[11px] leading-none tracking-wide text-foreground/55">
          周观察
        </span>
      )
    }
  </div>
  <a
    href={getPath(id, filePath)}
    class:list={[
      "inline-block text-xl leading-snug font-semibold text-foreground transition-colors hover:text-accent",
      "decoration-dashed underline-offset-4 hover:underline",
      "focus-visible:no-underline focus-visible:underline-offset-0",
    ]}
  >
    <Heading
      style={{ viewTransitionName: slugifyStr(title.replaceAll(".", "-")) }}
    >
      {title}
    </Heading>
  </a>
  <p class="mt-2 text-sm leading-7 text-foreground/75 sm:text-base">
    {description}
  </p>
</li>
