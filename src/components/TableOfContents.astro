---
type Props = {
  headings: { depth: number; slug: string; text: string }[];
  kind: "mobile" | "desktop";
};

const { headings, kind } = Astro.props;
---

{
  kind === "mobile" ? (
    <details class="post-toc post-toc-mobile" data-pagefind-ignore>
      <summary>
        本文目录 <span>{headings.length} 节</span>
      </summary>
      <nav aria-label="本文目录">
        <ol>
          {headings.map(heading => (
            <li>
              <a href={`#${encodeURIComponent(heading.slug)}`}>
                {heading.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </details>
  ) : (
    <nav
      class="post-toc post-toc-desktop"
      aria-label="本文目录"
      data-pagefind-ignore
    >
      <p class="toc-label">本文目录</p>
      <ol>
        {headings.map(heading => (
          <li>
            <a href={`#${encodeURIComponent(heading.slug)}`}>{heading.text}</a>
          </li>
        ))}
      </ol>
    </nav>
  )
}

<style>
  .post-toc {
    font-size: 0.8125rem;
    line-height: 1.7;
  }

  .post-toc ol {
    display: grid;
    gap: 0.875rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .post-toc a {
    display: block;
    color: color-mix(in srgb, var(--foreground) 70%, transparent);
    transition: color 150ms ease;
  }

  .post-toc a:hover,
  .post-toc a:focus-visible {
    color: var(--accent);
  }

  .post-toc-mobile {
    margin-block: 1.5rem 2.25rem;
    padding-block: 0.875rem;
    border-block: 1px solid var(--border);
  }

  .post-toc-mobile summary {
    cursor: pointer;
    font-weight: 600;
  }

  .post-toc-mobile summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .post-toc-mobile summary span {
    margin-inline-start: 0.5rem;
    color: color-mix(in srgb, var(--foreground) 65%, transparent);
    font-weight: 400;
  }

  .post-toc-mobile nav {
    padding-top: 1.25rem;
  }

  .post-toc-desktop {
    max-height: calc(100svh - 6rem);
    overflow-y: auto;
    padding-inline: 1.25rem 0.25rem;
    border-inline-start: 1px solid var(--border);
    scrollbar-width: thin;
  }

  .toc-label {
    margin-block: 0 1.25rem;
    color: var(--accent);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
  }

  @media (min-width: 1100px) {
    .post-toc-mobile {
      display: none;
    }
  }
</style>
